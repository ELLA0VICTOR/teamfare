# Local API. Set APP_ORIGIN to the browser's exact URL.
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/teamfare.sqlite
TZ=Africa/Lagos
# Production requires HTTPS and NODE_ENV=production (secure session cookies).
# NODE_ENV=production
# Only behind one trusted reverse proxy; keep the API port private.
# TRUST_PROXY=1

# Planning agent: keep real credentials in .env only.
VULTR_INFERENCE_API_KEY=
# Run npm run agent:models to list current tool-calling model IDs (no key needed).
VULTR_INFERENCE_MODEL=
TAVILY_API_KEY=

# Account email verification (Resend). Use a verified sender domain for real users.
RESEND_API_KEY=
EMAIL_FROM=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Deployment operator only. Never pass the management key into the app container.
VULTR_API_KEY=
TEAMFARE_DOMAIN=teamfare.dixmail.xyz
