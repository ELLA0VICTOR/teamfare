{
  "name": "teamfare",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": { "node": ">=24.19.0 <25" },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "test:api": "node --test server/tests/*.test.ts",
    "test:live": "playwright test -c playwright.live.config.ts",
    "test:agent": "playwright test -c playwright.agent.config.ts",
    "agent:models": "node server/agent/models.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:browser": "playwright test",
    "format": "prettier --write src server tests playwright.config.ts playwright.live.config.ts playwright.agent.config.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.9",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "fastify": "^5.12.8",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "oxlint": "^1.89.0",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2",
    "vite": "^8.3.5"
  }
}
