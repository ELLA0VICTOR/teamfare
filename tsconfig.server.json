{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "NodeNext", "moduleResolution": "NodeNext",
    "types": ["node"], "strict": true, "skipLibCheck": true, "noEmit": true,
    "allowImportingTsExtensions": true, "verbatimModuleSyntax": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "erasableSyntaxOnly": true
  },
  "include": ["server/**/*.ts"]
}
